# Gateway yang dapat dijangkau browser atau perangkat yang menjalankan Expo Go.
# Lokal/web: http://localhost:8080
# Ponsel fisik: http://IP-LAN-LAPTOP:8080
# Codespaces: https://NAMA-CODESPACE-8080.app.github.dev
# Opsional: isi hanya jika ingin memaksa URL tertentu.
# Penting: jangan isi dengan URL Codespace milik orang lain.
# Untuk tim di Codespaces, paling aman jalankan "npm run start:codespaces"
# karena script akan otomatis set URL API sesuai CODESPACE masing-masing.
# EXPO_PUBLIC_API_URL=
